{
  "name": "better-form",
  "version": "0.3.0",
  "description": "Training log, recovery, recommendations and nutrition in Obsidian.",
  "main": "main.js",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "npm run typecheck && node esbuild.config.mjs production",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run build && node scripts/deploy.mjs"
  },
  "author": "ssestorad",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.19.0",
    "esbuild": "^0.28.2",
    "esbuild-svelte": "^0.9.5",
    "obsidian": "^1.13.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  }
}
